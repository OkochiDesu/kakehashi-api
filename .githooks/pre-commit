#!/bin/bash
# pre-commit フック
# ステージされた変更に、よくある形式のシークレット（APIキー・トークン・秘密鍵等）が
# 含まれていないかを簡易チェックする

PATTERNS=(
    'AKIA[0-9A-Z]{16}'                   # AWS Access Key ID
    '-----BEGIN [A-Z ]*PRIVATE KEY-----'  # 秘密鍵
    'AIza[0-9A-Za-z_-]{35}'               # Google API Key
    'gh[pousr]_[0-9A-Za-z]{36,}'          # GitHub Token (PAT/OAuth/User/Server)
    'xox[baprs]-[0-9A-Za-z-]{10,}'        # Slack Token
)

found=0
while IFS= read -r file; do
    [[ -f "$file" ]] || continue
    for pattern in "${PATTERNS[@]}"; do
        if git diff --cached -U0 -- "$file" | grep -E -q -- "$pattern"; then
            echo "[pre-commit] ${file} にシークレットらしき文字列が含まれています（pattern: ${pattern}）"
            found=1
        fi
    done
done < <(git diff --cached --name-only --diff-filter=ACM)

if [[ $found -eq 1 ]]; then
    echo ""
    echo "シークレットを含む変更はcommitしないでください。誤検知の場合は --no-verify でスキップできます:"
    echo "  git commit --no-verify"
    exit 1
fi

# 現在のブランチに対応するPRがマージ済みの場合、新しい作業ブランチでのcommitを促す
# gh CLIが未インストール・未認証の場合はチェックできないため、commitをブロックする（fail-closed）
if ! command -v gh >/dev/null 2>&1; then
    echo "[pre-commit] gh CLIが見つかりません。PRマージ済みチェックを実行できません。"
    echo "devcontainerのリビルドでgh CLIが導入されます。"
    echo "誤検知やこのチェックをスキップしたい場合は --no-verify でスキップできます:"
    echo "  git commit --no-verify"
    exit 1
fi

if ! gh auth status >/dev/null 2>&1; then
    echo "[pre-commit] gh CLIが未認証のため、PRマージ済みチェックを実行できません。"
    echo "先に 'gh auth login' を実行してください（手順: docs/troubleshooting/devcontainer-ssh-agent-forwarding.md）。"
    echo "誤検知やこのチェックをスキップしたい場合は --no-verify でスキップできます:"
    echo "  git commit --no-verify"
    exit 1
fi

pr_state=$(gh pr view --json state -q .state 2>/dev/null)
if [[ "$pr_state" == "MERGED" ]]; then
    echo "[pre-commit] 現在のブランチに対応するPRはマージ済み（MERGED）です。"
    echo "新しい作業ブランチを作成してからcommitしてください（CLAUDE.md の commit運用を参照）:"
    echo "  git checkout -b feature/<内容> origin/main"
    echo ""
    echo "誤検知やこのチェックをスキップしたい場合は --no-verify でスキップできます:"
    echo "  git commit --no-verify"
    exit 1
fi

# .githooks/ 配下のファイルが staged されている場合に構文チェックを実行する
# 未インストールの場合はスキップ（Dev Container リビルドで shellcheck が導入される）
if command -v shellcheck &>/dev/null; then
    staged_hooks=$(git diff --cached --name-only --diff-filter=ACM | grep '^\.githooks/' || true)
    if [[ -n "$staged_hooks" ]]; then
        echo "[pre-commit] shellcheck でフックファイルを検証します..."
        echo "$staged_hooks" | xargs shellcheck || {
            echo ""
            echo "shellcheck エラーを修正してから commit してください。"
            echo "スキップする場合は --no-verify を使用してください。"
            exit 1
        }
    fi
fi

# src/main/kotlin 配下の staged ファイルに英語エラーメッセージが含まれていないか確認する
# require() / check() / Exception() 等の引数が ASCII 英字のみの場合は日本語化を促す
staged_main_kt=$(git diff --cached --name-only --diff-filter=ACM | grep '^src/main/kotlin/.*\.kt$' || true)
if [[ -n "$staged_main_kt" ]]; then
    english_msgs=$(
        echo "$staged_main_kt" | while IFS= read -r f; do
            git diff --cached -U0 -- "$f" \
              | grep '^+' | grep -v '^+++' \
              | grep -E 'require\(|check\(|checkNotNull\(|requireNotNull\(|Exception\(' \
              | grep -E '\{ "' \
              | LC_ALL=C grep -v '[^ -~]' \
              | sed "s|^|  ${f}: |"
        done
    )
    if [[ -n "$english_msgs" ]]; then
        echo "[pre-commit] エラーメッセージに英語が含まれています（日本語で記述してください）:"
        echo "$english_msgs"
        echo ""
        echo "誤検知の場合は --no-verify でスキップできます:"
        echo "  git commit --no-verify"
        exit 1
    fi
fi

# src/test/kotlin 配下の staged ファイルに assert() 誤使用がないか確認する
# JVM の -ea が無効だと assert() は評価されないため JUnit アサーションを使うこと
staged_test_kt=$(git diff --cached --name-only --diff-filter=ACM | grep '^src/test/kotlin/.*Test\.kt$' || true)
if [[ -n "$staged_test_kt" ]]; then
    bad_asserts=$(
        echo "$staged_test_kt" | while IFS= read -r f; do
            git diff --cached -U0 -- "$f" \
              | grep '^+' | grep -v '^+++' \
              | grep -E '^\+[[:space:]]*assert\(' \
              | sed "s|^|  ${f}: |"
        done
    )
    if [[ -n "$bad_asserts" ]]; then
        echo "[pre-commit] assert() は JVM の -ea が無効だと評価されません。assertEquals / assertTrue / assertThrows 等を使ってください:"
        echo "$bad_asserts"
        echo ""
        echo "誤検知の場合は --no-verify でスキップできます:"
        echo "  git commit --no-verify"
        exit 1
    fi
fi

# src/test/kotlin 配下の staged *Test.kt ファイルで companion object に @Container を使っているのに
# @JvmStatic がない場合はコミットをブロックする
# companion object の @Container は @JvmStatic なしでは JVM 上で static にならず正常動作しない
# インスタンスフィールドの @Container（テストごとに起動）は companion object 不要のため対象外
# 詳細: docs/troubleshooting/testcontainers-jvmstatic-kotlin.md
if [[ -n "$staged_test_kt" ]]; then
    missing_jvmstatic=$(
        echo "$staged_test_kt" | while IFS= read -r f; do
            if git show ":${f}" | grep -q '@Container' && git show ":${f}" | grep -q 'companion object' && ! git show ":${f}" | grep -q '@JvmStatic'; then
                echo "  ${f}"
            fi
        done
    )
    if [[ -n "$missing_jvmstatic" ]]; then
        echo "[pre-commit] companion object 内の @Container には @JvmStatic が必要です:"
        echo "$missing_jvmstatic"
        echo "  詳細: docs/troubleshooting/testcontainers-jvmstatic-kotlin.md"
        echo ""
        echo "誤検知の場合は --no-verify でスキップできます:"
        echo "  git commit --no-verify"
        exit 1
    fi
fi

exit 0

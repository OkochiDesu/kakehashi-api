{
    // Dev Container の表示名
    "name": "Kotlin & Postgres Dev Environment",
    // 使用する Docker Compose ファイルを指定
    "dockerComposeFile": "docker-compose.yml",
    // docker-compose.yml 内でアタッチするサービス名
    "service": "app",
    // コンテナ内のワークスペースルートディレクトリ
    "workspaceFolder": "/kakehashi-api",
    // 追加ツール（gh CLI: commit前のPRマージ状態確認やCI設定の手元検証に使用）
    // shellcheck: .githooks/ 変更時のpre-commitチェックとCI（Workflow Lint）と同じ検証をローカルで実行するために使用
    // docker-outside-of-docker: ホストの Docker ソケット（docker-compose.yml でマウント済み）へのアクセス権限設定と
    //   Docker CLI インストールを行う。Testcontainers のローカル実行（./gradlew test）に必要
    // 注：Bookworm以降のGLIBC 2.36対応により、nanolayerの互換性問題が解決
    "features": {
        "ghcr.io/devcontainers/features/github-cli:1": {},
        "ghcr.io/devcontainers-extra/features/shellcheck:1": {},
        "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
    },
    // リビルド後もワークスペース内に Gradle キャッシュを保持する
    // Testcontainers: Docker-outside-of-Docker 環境では Ryuk がコンテナ側に戻れないため無効化し、
    // PostgreSQL 等のポートアクセスは host.docker.internal (Docker Desktop の host IP) 経由にする
    "remoteEnv": {
        "GRADLE_USER_HOME": "/kakehashi-api/.gradle-user-home",
        "TESTCONTAINERS_RYUK_DISABLED": "true",
        "TESTCONTAINERS_HOST_OVERRIDE": "host.docker.internal"
    },
    // VS Code の設定（拡張機能など）
    "customizations": {
        "vscode": {
            // コンテナ起動時に自動インストールする拡張機能
            "extensions": [
                "fwcd.kotlin", // Kotlinサポート
                "vscjava.vscode-java-pack", // Javaツールパック（デバッガ・ビルドツール等）
                "ryanluker.vscode-coverage-gutters", // テストカバレッジのガター表示
                "anthropic.claude-code" // ClaudeCode拡張（リビルド後に消えるため明示的に指定）
            ]
        }
    },
    // コンテナ内で使用するユーザー名
    "remoteUser": "vscode",
    // コンテナ作成後に実行するコマンド（git hooks 有効化と Gradle Wrapper の事前取得）
    "postCreateCommand": "sh -lc 'mkdir -p \"$GRADLE_USER_HOME\" && git config core.hooksPath .githooks && ./gradlew --version'"
}